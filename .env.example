# =====================
# Database Configuration
# =====================
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@HOST:3306/soombrella
# 예시:
# DATABASE_URL=mysql+pymysql://soombra_user:user_pw@localhost:3306/soombrella

# =====================
# JWT / Security
# =====================
SECRET_KEY=change_this_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =====================
# App Info
# =====================
APP_ENV=local
APP_NAME=Soombrella Backend